{
  "name": "stronghold-protocol-desktop",
  "productName": "卫戍协议",
  "version": "0.2.4-desktop.0",
  "private": true,
  "description": "卫戍协议：盟约 desktop client (unofficial fan remake; local art, remote game server)",
  "license": "GPL-3.0-or-later",
  "author": "Stronghold Protocol contributors",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dir:win": "electron-builder --win dir --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.stronghold-protocol.desktop",
    "productName": "卫戍协议",
    "executableName": "卫戍协议",
    "artifactName": "Stronghold-Protocol-Desktop-${version}-win-x64.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "*.js",
      "*.mjs",
      "*.cjs",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../public",
        "to": "game/public",
        "filter": [
          "**/*",
          "!dev/**",
          "!assets/**"
        ]
      },
      {
        "from": "../data",
        "to": "game/data",
        "filter": [
          "**/*",
          "!local-assets.json"
        ]
      },
      {
        "from": "../shared",
        "to": "game/shared"
      },
      {
        "from": "../server",
        "to": "game/server"
      },
      {
        "from": "../packs",
        "to": "game/packs"
      },
      {
        "from": "../node_modules/ws",
        "to": "game/node_modules/ws",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE-Stronghold-Protocol.txt"
      },
      {
        "from": "../NOTICE.md",
        "to": "NOTICE.md"
      },
      {
        "from": "../THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "art-manifest.json",
        "to": "art-manifest.json"
      }
    ],
    "win": {
      "icon": "../public/icons/app-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shixiliya1",
        "repo": "Stronghold-Protocol"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "卫戍协议",
      "artifactName": "Stronghold-Protocol-Desktop-Setup-${version}.${ext}",
      "differentialPackage": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
